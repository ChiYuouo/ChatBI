OPENAI_API_KEY="your_openai_api_key"
OPENAI_BASE_URL="your_openai_base_url"
LLM_MODEL="your_llm_model"
EMBEDDING_MODEL="your_embedding_model"
# 索引根目录；本地默认 chroma_db，Compose 使用持久卷 /app/chroma_db
CHROMA_PERSIST_DIR="chroma_db"

FRONTEND_PORT="8300"
# Windows 若端口被系统保留，可分别改为 18300 和 18000
BACKEND_PORT="8000"

# 允许访问 API 的前端地址，多个地址用英文逗号分隔
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

DB_HOST="localhost"
DB_PORT="3307"
MYSQL_ROOT_PASSWORD="your_mysql_admin_password"
DB_USER="chatbi_reader"
DB_PASSWORD="your_mysql_readonly_password"
DB_NAME="chatbi_mvp"
DB_CONNECT_TIMEOUT="5"
DB_READ_TIMEOUT="8"
DB_WRITE_TIMEOUT="8"
DB_POOL_SIZE="5"
DB_POOL_MAX_OVERFLOW="5"
DB_POOL_TIMEOUT="3"
DB_SLOW_QUERY_THRESHOLD_MS="200"
# 单次 SQL 的结果行数、UTF-8 序列化大小与服务端执行时间上限
DB_MAX_RESULT_ROWS="1000"
DB_MAX_RESULT_BYTES="1048576"
DB_SQL_TIMEOUT_MS="5000"
# 单次查询/整次多步分析共享；修复重试不重置预算
ANALYSIS_TIMEOUT_SECONDS="120"
ANALYSIS_MAX_SQL_EXECUTIONS="20"
ANALYSIS_MAX_RESULT_BYTES="4194304"
LLM_TIMEOUT_SECONDS="30"

# token 签名密钥；不配置则每次重启后所有登录失效
JWT_SECRET="change-me-to-a-long-random-string"

# ============ 功能开关（代码默认全关，在此显式开启） ============
FEATURE_FEW_SHOT="true"
FEATURE_RULES="true"
FEATURE_GUARDS="true"
FEATURE_INDICATOR_KNOWLEDGE="true"
FEATURE_SCHEMA_LINKING="true"
FEATURE_INDICATOR_RAG="true"
FEATURE_QUERY_REWRITE="true"

# 每次回灌给模型的最近轮数
SESSION_HISTORY_TURNS="8"
# 会话历史保留天数；超期记录会在下一次提问时被清理
SESSION_RETENTION_DAYS="7"
# 单个会话最多保留的轮数，超出则删除最旧的
SESSION_MAX_TURNS="100"

# 查询链路审计存储；只记录 SQL 摘要，不保存问题、SQL 正文或结果
AUDIT_DB_PATH="data/audit.db"
