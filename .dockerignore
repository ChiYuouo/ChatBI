# 版本控制与 IDE
.git/
.gitignore
.idea/

# 本地虚拟环境与缓存
.venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/

# 密钥：运行时通过 compose 的 env_file / environment 注入，绝不进镜像
.env
.env.*
!.env.example

# 本地账户、会话和 SQLite 临时文件不能进入构建上下文或镜像
data/*.db
data/*.db-*
data/*.sqlite*

# 前端有自己的构建上下文，后端镜像不需要
frontend/

# 编排文件与文档
docker-compose.yml
docker/
reports/
README.md
