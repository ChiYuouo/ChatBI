# Byte-compiled / optimized Python files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Test and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment variables and local secrets
.env
.env.*
!.env.example

# IDE settings
.idea/
.vscode/

# Logs and local data
*.log
*.sqlite3
reports/

# Local session store (SQLite, created at runtime)
data/sessions.db*

# Local user store (SQLite, contains password hashes)
data/users.db*

# OS files
.DS_Store
Thumbs.db

# Frontend
node_modules/
dist/
.vite/

# Derived vector index (rebuildable via build_indicator_index / ensure_indexes)
chroma_db/

# Assistant working memory (project work logs, not source code)
.workbuddy/
